{
  "info": {
    "_postman_id": "8d2d7f3f-9f8e-4e75-b0de-63f9f91d6a10",
    "name": "Post Pilot Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "codex"
  },
  "event": [],
