  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF Cookie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontend_origin}}"
              },
              {
                "key": "Referer",
                "value": "{{frontend_origin}}/"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sanctum/csrf-cookie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sanctum",
                "csrf-cookie"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF cookie bootstrap returns 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "const token = pm.cookies.get('XSRF-TOKEN');",
                  "pm.test('XSRF-TOKEN cookie is available', function () {",
                  "    pm.expect(token).to.exist;",
                  "});",
                  "if (token) {",
                  "    pm.environment.set('xsrf_token_decoded', decodeURIComponent(token));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('xsrf_token_decoded');",
                  "if (token) {",
                  "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontend_origin}}"
              },
              {
                "key": "Referer",
                "value": "{{frontend_origin}}/"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token_decoded}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Secure123\",\n  \"password_confirmation\": \"Secure123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
